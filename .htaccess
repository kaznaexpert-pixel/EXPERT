# ============================================================
# .htaccess для kaznaexpert.ru
# Дата: 2026-05-28
# Сборка: HTTP→HTTPS (было), 301 www→без-www (новое),
#         блокировка /222/ (новое), кэширование (новое),
#         security headers (новое), блокировка IP (было)
# ============================================================

# --- ВКЛЮЧЕНИЕ ДВИЖКА ПЕРЕЗАПИСИ ---
RewriteEngine On
RewriteBase /

# --- 1+2. HTTPS + WWW → канонический хост ОДНИМ хопом ---
# Объединено [OR]-условием: http://www.…/старый-url даёт максимум 2 хопа
# (канонизация + легаси-редирект), а не 3, как при раздельных правилах.
RewriteCond %{SERVER_PORT} !^443$ [OR]
RewriteCond %{HTTP_HOST} ^www\.kaznaexpert\.ru$ [NC]
RewriteRule ^(.*)$ https://kaznaexpert.ru/$1 [R=301,L]

# --- 3. /222/ → 410 Gone (выпиливаем мусор из индекса) ---
# Папка /222/ — тестовый шаблон, физически удаляется. Этот блок
# гарантирует, что Яндекс/Google получат сигнал «страница навсегда удалена»
# и выкинут её из выдачи. Действует даже если файлы остались.
RewriteRule ^222(/.*)?$ - [G,L]

# Легаси-CMS 2023: закрыта ЦЕЛИКОМ (410) — включая demo.html и uploads/,
# чтобы посторонний контент не индексировался ни классикой, ни AI-краулерами.
RewriteRule ^cms(/.*)?$ - [G,L]

# Локальный build-артефакт — не для веба
RewriteRule ^build(/.*)?$ - [G,L]

# --- Старые статьи блога 2022–2023 → актуальные статьи базы знаний (301) ---
RewriteRule ^blog/article_01\.html$ /baza-znaniy/kto-popadaet-pod-kaznacheyskoe-soprovozhdenie/ [R=301,L]
RewriteRule ^blog/article_02\.html$ /baza-znaniy/poryadok-kaznacheyskogo-soprovozhdeniya-sredstv/ [R=301,L]
# Раздел /blog/ закрыт (тонкий legacy-контент) → хаб базы знаний
RewriteRule ^blog/?$ /baza-znaniy/ [R=301,L]

# --- Удалённые страницы экспертов → /komanda/ (301) ---
RewriteRule ^komanda/(anton|elena|natalya|stella|yuliya|anna)/?$ /komanda/mihailov-yaroslav/ [R=301,L]
RewriteRule ^komanda/?$ /komanda/mihailov-yaroslav/ [R=301,L]
# --- Дубль статьи об авансе → каноническая (301, склейка МПК 02.07.2026) ---
RewriteRule ^baza-znaniy/kaznacheyskoe-soprovozhdenie-avansovyh-platezhey/?$ /baza-znaniy/avans-pri-kaznacheyskom-soprovozhdenii/ [R=301,L]

# --- 4. Защитные паттерны: убираем index.php из URL ---
# Когда пользователь вбивает kaznaexpert.ru/index.php — редирект на /
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.php[?\s] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# --- 5. Удаление множественных слешей ---
RewriteCond %{THE_REQUEST} //
RewriteCond %{REQUEST_URI} ^(.*?)//+(.*)$
RewriteRule . %1/%2 [R=301,L]

# ============================================================
# КЭШИРОВАНИЕ (Cache-Control + Expires)
# Заменяет no-store, no-cache из текущих заголовков
# ============================================================

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 month"

  # HTML — короткий кэш (5 минут)
  ExpiresByType text/html                     "access plus 5 minutes"
  ExpiresByType application/xhtml+xml         "access plus 5 minutes"

  # XML и текстовые — короткий
  ExpiresByType application/xml               "access plus 1 hour"
  ExpiresByType text/xml                      "access plus 1 hour"
  ExpiresByType application/json              "access plus 1 hour"

  # CSS и JS — месяц (версионирование через ?v=... в HTML)
  ExpiresByType text/css                      "access plus 1 month"
  ExpiresByType application/javascript        "access plus 1 month"
  ExpiresByType text/javascript               "access plus 1 month"

  # Изображения — год
  ExpiresByType image/jpeg                    "access plus 1 year"
  ExpiresByType image/jpg                     "access plus 1 year"
  ExpiresByType image/png                     "access plus 1 year"
  ExpiresByType image/gif                     "access plus 1 year"
  ExpiresByType image/webp                    "access plus 1 year"
  ExpiresByType image/avif                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 year"
  ExpiresByType image/x-icon                  "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon      "access plus 1 year"

  # Шрифты — год
  ExpiresByType font/woff                     "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType application/font-woff         "access plus 1 year"
  ExpiresByType application/font-woff2        "access plus 1 year"
  ExpiresByType application/x-font-ttf        "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

  # PDF и документы
  ExpiresByType application/pdf               "access plus 1 month"

  # robots.txt и sitemap — день (чтобы поисковики получали свежее)
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt|llms-full\.txt|humans\.txt)$">
    ExpiresDefault "access plus 1 day"
  </FilesMatch>
</IfModule>

# Cache-Control более точный, чем Expires
# Страницы с собственным no-store (страница «спасибо») исключаем из общего правила,
# иначе в ответе получаются ДВА разных Cache-Control (подтверждено live-проверкой).
SetEnvIf Request_URI "^/spasibo/" NO_CACHE_PAGE
<IfModule mod_headers.c>
  # HTML — короткий кэш
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "public, max-age=300, must-revalidate" env=!NO_CACHE_PAGE
  </FilesMatch>
  # Для NO_CACHE_PAGE гасим и наследие mod_expires (Expires + max-age),
  # затем ставим единственный Cache-Control: no-store
  Header unset Cache-Control env=NO_CACHE_PAGE
  Header unset Expires env=NO_CACHE_PAGE
  Header set Cache-Control "no-store" env=NO_CACHE_PAGE

  # CSS / JS — месяц с обязательной проверкой
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Картинки и шрифты — immutable на год
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # AI-файлы — день
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt|llms-full\.txt|humans\.txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

# ============================================================
# ЗАГОЛОВКИ БЕЗОПАСНОСТИ
# ============================================================

<IfModule mod_headers.c>
  # HSTS — принудительный HTTPS на год + поддомены + preload
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Запрет MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"

  # X-Frame-Options — защита от clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Referrer-Policy — какие данные передавать в заголовке Referer
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions-Policy — отключение фичей браузера, которые не нужны
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=()"

  # X-XSS-Protection — устарел в современных браузерах, но для старых браузеров оставляем
  Header always set X-XSS-Protection "1; mode=block"

  # Content-Security-Policy — базовая. После проверки можно ужесточить.
  # Сейчас разрешены: счётчики Я.Метрики, GA4, Top.Mail.Ru, шрифты Google
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://www.googletagmanager.com https://www.google-analytics.com https://top-fwz1.mail.ru https://api.telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://mc.yandex.ru https://www.google-analytics.com https://api.telegram.org; frame-src 'self' https://mc.yandex.ru https://yandex.ru https://*.yandex.ru https://api-maps.yandex.ru; object-src 'none'; base-uri 'self'; form-action 'self';"

  # Разрешение длинных сниппетов и больших превью для ИИ-поиска
  Header always set X-Robots-Tag "max-snippet:-1, max-image-preview:large, max-video-preview:-1"
</IfModule>

# ============================================================
# СЖАТИЕ (gzip / brotli)
# ============================================================

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/x-font-ttf font/opentype
</IfModule>

# ============================================================
# КОДИРОВКА
# ============================================================

AddDefaultCharset UTF-8
AddCharset UTF-8 .html .htm .css .js .json .xml .txt .md

# ============================================================
# СКРЫТИЕ ЧУВСТВИТЕЛЬНЫХ ФАЙЛОВ
# ============================================================

# Блокируем доступ к скрытым файлам и папкам (.git, .env, .htaccess сам, и т.д.)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Блокируем доступ к бэкап- и временным файлам
<FilesMatch "\.(bak|backup|swp|old|sql|log|orig|tmp)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Блокируем доступ к ini-файлам PHP
<FilesMatch "\.(ini)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Блокируем README, composer и прочие dev-файлы
<FilesMatch "(README|CHANGELOG|composer\.json|composer\.lock|package\.json|package-lock\.json)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# ============================================================
# СЛУЖЕБНЫЕ ИСКЛЮЧЕНИЯ
# ============================================================

# Разрешаем 403.shtml (на случай кастомной страницы ошибки)
<Files 403.shtml>
  Order allow,deny
  Allow from all
</Files>

# Разрешаем yandex_*.html и google*.html (верификация поисковиков)
<FilesMatch "^(yandex_[a-f0-9]+\.html|google[a-f0-9]+\.html)$">
  Order allow,deny
  Allow from all
</FilesMatch>

# Разрешаем папку .well-known (для SSL-сертификатов и др.)
<IfModule mod_alias.c>
  RewriteRule ^\.well-known/ - [L]
</IfModule>

# ============================================================
# БЛОКИРОВКА ВРЕДОНОСНЫХ IP (сохранено из старого .htaccess)
# ============================================================

Order allow,deny
deny from 77.91.194.186
deny from 217.66.154.129
allow from all

# ============================================================
# КАСТОМНЫЕ СТРАНИЦЫ ОШИБОК (опционально, на будущее)
# ============================================================

ErrorDocument 404 /404.php
# ErrorDocument 500 /500.html

# ============================================================
# КОНЕЦ .htaccess
# Замечания:
# - cPanel-сгенерированные блоки <IfModule php7_module> УБРАНЫ
#   (PHP 7.3 больше не используется, обновлён до 8.2)
# - PHP-настройки теперь живут в /home/y98451/public_html/kaznaexpert.ru/.user.ini
# - При обновлении PHP до 8.3+ ничего трогать не нужно
# ============================================================
